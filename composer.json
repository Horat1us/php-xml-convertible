{
  "name": "horat1us/php-xml-convertible",
  "description": "PHP Xml Convertible Object Trait",
  "license": "MIT",
  "authors": [
    {
      "name": "Alexander Letnikow",
      "email": "reclamme@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Horat1us\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Horat1us\\Tests\\": "tests",
      "Horat1us\\Examples\\": "examples/src"
    }
  },
  "config": {
    "process-timeout": 1800,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "lint": "./vendor/bin/phpcs --standard=PSR12 ./src ./tests",
    "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 ./src ./tests",
    "test": "./vendor/bin/phpunit",
    "cover": "./vendor/bin/phpunit --coverage-text",
    "cover-xml": "./vendor/bin/phpunit --coverage-clover ./coverage.xml"
  }
}
